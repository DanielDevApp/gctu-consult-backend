# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gctu_consult

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# How long before a confirmed consultation's start time the "coming up"
# reminder notification/email fires. Optional — defaults to 60 if unset.
REMINDER_MINUTES_BEFORE=60

# Default super admin (used by `npm run seed:admin`)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@gctu.edu.gh
SEED_ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP) — used to send registration verification codes and
# "forgot password" reset links.
# Leave SMTP_HOST blank to run without real email: codes/links are just
# logged to this server's console instead, so the flow still works locally.
# Example values for a Gmail account (use an App Password, not your real password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your_16_char_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GCTU Consult" <no-reply@gctu-consult.local>
